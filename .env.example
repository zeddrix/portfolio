# Public site URL used for canonical links, Open Graph URLs, sitemap, and robots.txt.
# For GitHub Project Pages (no trailing slash), e.g.:
# PUBLIC_SITE_URL=https://zeddrix.github.io/portfolio
PUBLIC_SITE_URL=

# Repo subpath for GitHub Project Pages. Leave empty for local dev at site root.
# CI sets this automatically from the repository name, e.g. /portfolio
BASE_PATH=

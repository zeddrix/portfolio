# Supabase Configuration
PUBLIC_SUPABASE_URL=your-supabase-project-url
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
PUBLIC_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
POSTGRES_URL=postgresql://postgres:[password]@[host]:5432/postgres
SUPABASE_DB_PASSWORD=your-database-password

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# Resend Email Service (for contact form)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Email address to send from (must be verified in Resend)
# For testing: use 'onboarding@resend.dev'
# For production: use your verified domain (e.g., 'contact@yourdomain.com')
CONTACT_EMAIL_FROM=onboarding@resend.dev
# Your email address to receive contact form submissions
CONTACT_EMAIL_TO=your-email@example.com

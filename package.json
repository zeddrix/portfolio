{
	"name": "zeddrix-portfolio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"quality": "pnpm format && pnpm lint && pnpm check",
		"db:migrate": "tsx scripts/db/run-migrations.ts",
		"db:verify": "tsx scripts/db/run-migrations.ts --verify-only",
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:headed": "playwright test --headed",
		"test:debug": "playwright test --debug",
		"test:visual": "playwright test tests/e2e/visual/",
		"test:update-snapshots": "playwright test --update-snapshots"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,css,md}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@playwright/test": "^1.57.0",
		"@supabase/supabase-js": "^2.84.0",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"@tailwindcss/postcss": "^4.1.17",
		"@types/node": "^24.10.1",
		"@types/pg": "^8.15.6",
		"@typescript-eslint/eslint-plugin": "^8.47.0",
		"@typescript-eslint/parser": "^8.47.0",
		"autoprefixer": "^10.4.22",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.0",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^4.2.12",
		"svelte-check": "^3.6.0",
		"svelte-eslint-parser": "^1.4.0",
		"tailwindcss": "^4.1.17",
		"terser": "^5.44.1",
		"tsx": "^4.20.6",
		"typescript": "^5.3.0",
		"vite": "^5.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@tiptap/core": "^3.11.0",
		"@tiptap/extension-link": "^3.11.0",
		"@tiptap/extension-placeholder": "^3.11.0",
		"@tiptap/extension-underline": "^3.11.0",
		"@tiptap/pm": "^3.11.0",
		"@tiptap/starter-kit": "^3.11.0",
		"cloudinary": "^2.8.0",
		"motion": "^12.23.24",
		"pg": "^8.16.3",
		"resend": "^6.5.2",
		"sveltekit-superforms": "^2.28.1",
		"zod": "^4.1.12"
	}
}

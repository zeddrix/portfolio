{
  "name": "portfolio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "optimize:images": "node scripts/optimize-images.mjs",
    "assets:prepare": "node scripts/copy-fonts.mjs && node scripts/copy-certificate-sources.mjs && node scripts/optimize-images.mjs && node scripts/generate-og-image.mjs && tsx scripts/generate-legacy-redirects.ts",
    "assets:certificates-source": "node scripts/copy-certificate-sources.mjs",
    "generate:favicon": "node scripts/generate-favicon.mjs",
    "generate:og-image": "node scripts/generate-og-image.mjs",
    "generate:legacy-redirects": "tsx scripts/generate-legacy-redirects.ts",
    "generate:snapshot": "tsx scripts/export-portfolio-snapshot.ts",
    "generate:exports": "tsx scripts/generate-exports.ts",
    "generate:resume": "pnpm generate:snapshot && pnpm generate:exports && tsx scripts/generate-resume.ts",
    "prebuild": "pnpm assets:prepare",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts,.js --max-warnings=0",
    "quality": "pnpm format:check && pnpm lint && pnpm check",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:ui": "playwright test tests/e2e --ui",
    "test:e2e:one": "playwright test --workers=1",
    "test:e2e:preflight": "playwright test tests/e2e/playwright-dev-server-preflight.e2e.test.ts",
    "test:e2e:home": "playwright test tests/e2e/home",
    "test:e2e:projects": "playwright test tests/e2e/projects",
    "test:e2e:seo": "playwright test tests/e2e/seo",
    "test:e2e:journeys": "playwright test tests/e2e/journeys",
    "test:e2e:generate-matrix": "node scripts/generate-e2e-flow-coverage-matrix.mjs",
    "test:unit": "vitest run",
    "screenshots": "playwright test tests/visual/capture.spec.ts --config playwright.visual.config.ts",
    "screenshots:cta-hover": "playwright test tests/visual/hero-cta-hover-capture.spec.ts --config playwright.visual.config.ts",
    "screenshots:polish": "playwright test tests/visual/homepage-polish-capture.spec.ts --config playwright.visual.config.ts",
    "screenshots:certificates": "playwright test tests/visual/certificates-capture.spec.ts --config playwright.visual.config.ts",
    "screenshots:resume": "playwright test tests/visual/resume-application-capture.spec.ts tests/visual/resume-linkedin-capture.spec.ts --config playwright.visual.config.ts",
    "screenshots:project-periods": "playwright test tests/visual/project-period-capture.spec.ts --config playwright.visual.config.ts",
    "screenshots:manatal": "playwright test tests/visual/manatal-coop-capture.spec.ts --config playwright.visual.config.ts",
    "screenshots:chatbot-band": "playwright test tests/visual/chatbot-band-capture.spec.ts --config playwright.visual.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource/inter": "^5.2.8",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.49.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "2.5.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "autoprefixer": "^10.4.21",
    "docx": "^9.7.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "postcss": "^8.5.3",
    "prettier": "^3.6.2",
    "sharp": "^0.35.1",
    "svelte": "^4.2.19",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "to-ico": "^1.1.5",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^1.6.1"
  }
}
